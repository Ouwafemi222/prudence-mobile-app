# Frontend (Vite) — copy to .env.local and fill in values

# Google Search Console verification (HTML tag method)
# Get your code at https://search.google.com/search-console → Add property → HTML tag
VITE_GOOGLE_SITE_VERIFICATION=

# Public site URL (used in SEO; defaults to https://prudence-path.online)
VITE_SITE_URL=https://prudence-path.online

# Open Graph / social preview image (absolute URL, ideally on your domain)
VITE_OG_IMAGE=https://prudence-path.online/og-image.png

# Proof image similar-picture blocking (set to false for shadow/log-only mode)
VITE_PERCEPTUAL_DEDUP=true
