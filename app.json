{
  "expo": {
    "name": "THE PRUDENCE",
    "slug": "prudence-path-mobile-app",
    "scheme": "prudence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prudencepath.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "THE PRUDENCE uses the camera so you can snap a live photo of the book you read as proof.",
        "NSPhotoLibraryUsageDescription": "THE PRUDENCE uses your photo library so you can attach proof images."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.prudencepath.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#5B52EB",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#5B52EB",
          "defaultChannel": "prudence"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow THE PRUDENCE to attach photos as activity proof.",
          "cameraPermission": "Allow THE PRUDENCE to take a live photo of the book you read."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "66899e90-a194-4b71-8538-033950154f06"
      }
    },
    "owner": "gratitudeman"
  }
}
